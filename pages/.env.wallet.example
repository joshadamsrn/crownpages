# Wallet integration configuration
# Copy the values you actually use into .env.local

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Apple Wallet
APPLE_WALLET_TEAM_IDENTIFIER=
APPLE_WALLET_PASS_TYPE_IDENTIFIER=
APPLE_WALLET_ORGANIZATION_NAME=Crown Pages
APPLE_WALLET_WWDR_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
APPLE_WALLET_SIGNER_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"
APPLE_WALLET_SIGNER_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
